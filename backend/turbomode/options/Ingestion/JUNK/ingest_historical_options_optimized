"""
OPTIMIZED EODHD HISTORICAL OPTIONS INGESTION

This script uses an expiration-driven batched approach with symbol-level parallelism
to efficiently download 3 months of historical options chains from EODHD.

Key optimizations:
- Expiration-driven: Fetch expiration ladder once, then process by expiration
- Batched writes: Insert 100-2000 records per transaction
- Symbol-level parallelism: 4-8 workers processing symbols concurrently
- Caching: Cache expirations and strikes to avoid redundant API calls
- Rate limiting: Token bucket with 5 req/sec global limit
- Retry logic: Exponential backoff on 5xx errors
- SQLite WAL mode: Concurrent reads, faster writes

Usage:
    python ingest_historical_options_optimized.py [--workers 4] [--test]
"""
import os
import sys
import json
import sqlite3
import logging
import time
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple
from concurrent.futures import ProcessPoolExecutor, as_completed
from collections import defaultdict
import threading

